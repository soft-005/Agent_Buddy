{
    "providers": {
        "lmstudio": {
            "baseUrl": "http://127.0.0.1:1234/v1",
            "api": "openai-completions",
            "apiKey": "key",
            "timeout": 300,
            "models": [
                {
                    "id": "google/gemma-3n-e4b",
                    "name": "Gemma 3n E4B",
                    "description": "Gemma 3n E4B is a small, fast model for natural language understanding and generation tasks.",
                    "type": "llm",
                    "capabilities": ["text-generation", "text-completion", "question-answering"],
                    "maxTokens": 2048,
                    "temperature": 0.7,
                    "topP": 0.9,
                    "reasoning": true,
                    "contextWindow": 4096,
                    "input": ["text", "image"]
                },
                {
                    "id": "qwen/qwen3.5-9b",
                    "name": "Qwen35",
                    "description": "Qwen 3.5-9b is a large language model designed for natural language understanding, coding and generation tasks.",
                    "type": "llm",
                    "capabilities": ["text-generation", "text-completion", "question-answering", "tool-use", "reasoning", "vision"],
                    "maxTokens": 1024,
                    "temperature": 0.7,
                    "topP": 0.9,
                    "samplingParams": {
                        "reasoning_effort": "none"
                    },
                    "reasoning": true,
                    "contextWindow": 8192,
                    "input": ["text", "image"]
                }
            ]
        },
        "anthropic": {
            "api": "anthropic-messages",
            "apiKey": "$ANTHROPIC_API_KEY",
            "models": [
                {
                    "id": "claude-opus-5",
                    "name": "Claude Opus 5",
                    "maxTokens": 16000,
                    "reasoning": true,
                    "contextWindow": 1000000
                }
            ]
        }
    }
}
