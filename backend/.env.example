# Copy to backend/.env and fill in.

# Model selection: a provider and model id from providers.json.
# lmstudio = local model in LM Studio (start its server on port 1234 first)
# anthropic = Claude API (needs ANTHROPIC_API_KEY)
LLM_PROVIDER=lmstudio
LLM_MODEL=qwen/qwen3.5-9b

ANTHROPIC_API_KEY=
# Claude only: low keeps voice replies fast; raise to medium/high for harder conversations
CLAUDE_EFFORT=low

# Long-term memory in backend/data/memory.md (open it to see or edit what Buddy remembers)
MEMORY_ENABLED=true
# Tokens of memory added to each prompt
MEMORY_BUDGET=200

# The conversation is saved in backend/data/conversation.json, so Buddy picks up where you
# left off after a restart. "New conversation" in the apps moves it to data/conversations/.
SAVE_CONVERSATION=true

# The model starts each reply with a mood tag like [happy] and the avatar's face follows it.
# Turn off if a model handles the tags badly.
MOOD_TAGS=true

# Speech-to-text (faster-whisper): tiny | base | small | medium
WHISPER_MODEL=small
WHISPER_LANGUAGE=en

# Hands-free talking (turned on in the desktop tray or the phone's settings).
# Wake word mode answers sentences that start or end with one of these words (comma-separated).
WAKE_WORDS=buddy
# A pause this long (milliseconds) ends what you're saying
VAD_SILENCE_MS=800
# After Buddy answers, how long (seconds) you can reply without the wake word
FOLLOWUP_SECONDS=8

# Phone access is optional. false = only this PC can connect (default).
# true = a phone on the same Wi-Fi can connect too; the startup log prints its address.
LAN_ACCESS=false
# Buddy's port. The desktop app and buddy.ps1 read it from here too; the desktop
# tray's "Connection..." can change it. The phone needs it after the address if it isn't 8818.
PORT=8818
# Advanced: force a listen address. Leave commented out normally.
# HOST=127.0.0.1
